{
  "$id": "urn:edis:schema:browser:page-structure-summary",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "artifact-envelope.schema.json"
    }
  ],
  "properties": {
    "artifact_type": {
      "const": "page_structure_summary"
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "observations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "observation_index": {
                "minimum": 0,
                "type": "integer"
              },
              "page_context_id": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "page_fingerprint": {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "runtime_regions": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "bounding_rect": {
                      "additionalProperties": false,
                      "properties": {
                        "bottom": {
                          "type": "number"
                        },
                        "height": {
                          "minimum": 0,
                          "type": "number"
                        },
                        "left": {
                          "type": "number"
                        },
                        "right": {
                          "type": "number"
                        },
                        "top": {
                          "type": "number"
                        },
                        "width": {
                          "minimum": 0,
                          "type": "number"
                        },
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "top",
                        "right",
                        "bottom",
                        "left",
                        "width",
                        "height"
                      ],
                      "type": "object"
                    },
                    "landmark_role": {
                      "maxLength": 64,
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "region_kind": {
                      "enum": [
                        "HTML_LANDMARK",
                        "HTML_SECTION",
                        "ELEMENTOR_SECTION",
                        "ELEMENTOR_CONTAINER",
                        "ATOMIC_CONTAINER"
                      ]
                    },
                    "region_node_id": {
                      "pattern": "^node-[0-9]{6}$",
                      "type": "string"
                    },
                    "runtime_parent_region_node_id": {
                      "pattern": "^node-[0-9]{6}$",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "section_label": {
                      "additionalProperties": false,
                      "properties": {
                        "availability": {
                          "enum": [
                            "AVAILABLE",
                            "PARTIAL",
                            "INSUFFICIENT",
                            "DISABLED",
                            "UNAVAILABLE",
                            "NOT_APPLICABLE",
                            "ERROR"
                          ]
                        },
                        "source": {
                          "enum": [
                            "ELEMENTOR_EDITOR_LABEL",
                            "HTML_ID",
                            "LANDMARK_TAG",
                            "TECHNICAL_MARKER",
                            "NONE"
                          ]
                        },
                        "value": {
                          "maxLength": 300,
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "value",
                        "source",
                        "availability"
                      ],
                      "type": "object"
                    },
                    "source_binding_state": {
                      "enum": [
                        "EXACT",
                        "PROBABLE",
                        "AMBIGUOUS",
                        "UNMATCHED"
                      ]
                    },
                    "source_document_id": {
                      "maxLength": 160,
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "source_section_key": {
                      "pattern": "^sha256:[0-9a-f]{64}$",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "tag_name": {
                      "maxLength": 64,
                      "type": "string"
                    }
                  },
                  "required": [
                    "region_node_id",
                    "region_kind",
                    "tag_name",
                    "landmark_role",
                    "runtime_parent_region_node_id",
                    "source_binding_state",
                    "source_document_id",
                    "source_section_key",
                    "section_label",
                    "bounding_rect"
                  ],
                  "type": "object"
                },
                "maxItems": 1000,
                "type": "array"
              },
              "snapshot_id": {
                "format": "uuid",
                "type": "string"
              },
              "source_documents_present": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "binding_states": {
                      "items": {
                        "enum": [
                          "EXACT",
                          "PROBABLE",
                          "AMBIGUOUS",
                          "UNMATCHED"
                        ]
                      },
                      "maxItems": 4,
                      "type": "array"
                    },
                    "bound_runtime_node_count": {
                      "maximum": 100000,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "document_fingerprint": {
                      "pattern": "^sha256:[0-9a-f]{64}$",
                      "type": "string"
                    },
                    "document_id": {
                      "maxLength": 160,
                      "minLength": 1,
                      "type": "string"
                    },
                    "document_type": {
                      "maxLength": 120,
                      "type": "string"
                    }
                  },
                  "required": [
                    "document_id",
                    "document_type",
                    "document_fingerprint",
                    "binding_states",
                    "bound_runtime_node_count"
                  ],
                  "type": "object"
                },
                "maxItems": 500,
                "type": "array"
              },
              "summary": {
                "additionalProperties": false,
                "properties": {
                  "ambiguous_binding_count": {
                    "maximum": 100000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "exact_binding_count": {
                    "maximum": 100000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "probable_binding_count": {
                    "maximum": 100000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "runtime_region_count": {
                    "maximum": 100000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "source_document_count": {
                    "maximum": 100000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "unmatched_runtime_node_count": {
                    "maximum": 100000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "source_section_count": {
                    "maximum": 100000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "source_widget_count": {
                    "maximum": 100000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "runtime_section_region_count": {
                    "maximum": 100000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "runtime_container_region_count": {
                    "maximum": 100000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "runtime_widget_marker_count": {
                    "maximum": 100000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "document_instance_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "repeated_runtime_instance_group_count": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "source_document_count",
                  "runtime_region_count",
                  "exact_binding_count",
                  "probable_binding_count",
                  "ambiguous_binding_count",
                  "unmatched_runtime_node_count",
                  "source_section_count",
                  "source_widget_count",
                  "runtime_section_region_count",
                  "runtime_container_region_count",
                  "runtime_widget_marker_count",
                  "document_instance_count",
                  "repeated_runtime_instance_group_count"
                ],
                "type": "object"
              },
              "document_instances": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "document_instance_id",
                    "source_document_id",
                    "source_document_type",
                    "runtime_root_node_ids",
                    "bound_runtime_node_count",
                    "instance_index",
                    "binding_state",
                    "basis_evidence"
                  ],
                  "properties": {
                    "document_instance_id": {
                      "type": "string",
                      "pattern": "^document-instance-[0-9a-f]{16}$"
                    },
                    "source_document_id": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "source_document_type": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "runtime_root_node_ids": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "pattern": "^node-[0-9]{6}$"
                      }
                    },
                    "bound_runtime_node_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "instance_index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "binding_state": {
                      "enum": [
                        "EXACT",
                        "PROBABLE",
                        "AMBIGUOUS",
                        "UNMATCHED"
                      ]
                    },
                    "basis_evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 160
                      },
                      "maxItems": 20
                    }
                  }
                },
                "maxItems": 10000
              }
            },
            "required": [
              "observation_index",
              "snapshot_id",
              "page_context_id",
              "page_fingerprint",
              "source_documents_present",
              "summary",
              "runtime_regions",
              "document_instances"
            ],
            "type": "object"
          },
          "maxItems": 1000,
          "type": "array"
        }
      },
      "required": [
        "observations"
      ],
      "type": "object"
    },
    "schema_id": {
      "const": "urn:edis:schema:browser:page-structure-summary"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "type": "object"
}
