{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edis:schema:shared:artifact-envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_type",
    "producer",
    "captured_at",
    "canonicalization",
    "data",
    "diagnostics"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "pattern": "^urn:edis:schema:[a-z0-9:._-]+$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "artifact_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,100}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "version"
      ],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "hash_algorithm"
      ],
      "properties": {
        "profile": {
          "const": "EDIS-CJ-1"
        },
        "hash_algorithm": {
          "const": "sha256"
        }
      }
    },
    "data": {},
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "diagnostic.schema.json"
      },
      "maxItems": 100000
    }
  }
}
