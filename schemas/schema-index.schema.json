{
  "$id": "urn:edis:schema:browser:schema-index",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "artifact-envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "urn:edis:schema:browser:schema-index"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "schema_index"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_index_version",
        "schemas"
      ],
      "properties": {
        "schema_index_version": {
          "const": "1.0.0"
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "schema_id",
              "version"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*\\.json$",
                "maxLength": 160
              },
              "schema_id": {
                "type": "string",
                "pattern": "^urn:edis:schema:[a-z0-9:._-]+$",
                "maxLength": 200
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
              }
            }
          }
        }
      }
    }
  }
}
