{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edis:schema:browser:package-manifest",
  "allOf": [
    {
      "$ref": "artifact-envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "urn:edis:schema:browser:package-manifest"
    },
    "schema_version": {
      "const": "1.4.1"
    },
    "artifact_type": {
      "const": "runtime_package_manifest"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_bundle_id",
        "observation_set_id",
        "session_id",
        "package_validation_state",
        "capture_completeness",
        "partial_reasons",
        "files",
        "canonicalization_profile",
        "hash_algorithm",
        "snapshot_count",
        "screenshot_count"
      ],
      "properties": {
        "runtime_bundle_id": {
          "type": "string",
          "format": "uuid"
        },
        "observation_set_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "package_validation_state": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "capture_completeness": {
          "enum": [
            "COMPLETE",
            "PARTIAL"
          ]
        },
        "partial_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "canonicalization_profile": {
          "const": "EDIS-CJ-1"
        },
        "hash_algorithm": {
          "const": "sha256"
        },
        "snapshot_count": {
          "type": "integer",
          "minimum": 1
        },
        "screenshot_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
