{
  "description": "Local-only Manifest V3 runtime evidence collector for EDIS.",
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@types/chrome": "0.1.43",
    "@types/node": "25.9.3",
    "esbuild": "0.28.1",
    "eslint": "10.5.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "prettier": "3.8.4",
    "stylelint": "17.13.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "@edis/runtime-collector",
  "private": true,
  "scripts": {
    "audit": "npm audit --omit=dev",
    "build": "node build.mjs --target all",
    "build:chrome": "node build.mjs --target chrome",
    "build:edge": "node build.mjs --target edge",
    "build:reproducible": "node scripts/reproducible-build.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run validate:schemas && npm run build && npm run validate && npm run validate:package:external && npm run build:reproducible && npm run validate:store",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"tests/**/*.{ts,html,mjs}\" \"scripts/**/*.mjs\" \"build.mjs\" \"*.config.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,html}\" \"tests/**/*.{ts,html,mjs}\" \"scripts/**/*.mjs\" \"build.mjs\" \"*.config.{js,ts}\"",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" && stylelint \"src/**/*.css\"",
    "release:evidence": "node scripts/release-evidence.mjs",
    "release:gate": "node scripts/release-gate.mjs --browser all",
    "release:gate:chrome": "node scripts/release-gate.mjs --browser chrome",
    "release:gate:edge": "node scripts/release-gate.mjs --browser edge",
    "release:gate:no-browser": "node scripts/release-gate.mjs --no-browser",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs --browser chrome",
    "test:e2e:chrome": "node scripts/run-e2e.mjs --browser chrome",
    "test:e2e:debug": "node scripts/run-e2e.mjs --browser chrome --headed --debug",
    "test:e2e:edge": "node scripts/run-e2e.mjs --browser edge",
    "test:e2e:headed": "node scripts/run-e2e.mjs --browser chrome --headed",
    "test:unit": "node scripts/prepare-repository-tests.mjs && node scripts/run-repository-tests.mjs && node scripts/run-test-gate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "node scripts/check-source.mjs && node scripts/validate-package.mjs chrome && node scripts/validate-package.mjs edge && node scripts/compare-builds.mjs",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "validate:store": "node scripts/validate-store-docs.mjs",
    "performance:report": "node scripts/personal-performance-report.mjs",
    "release:gate:personal": "node scripts/personal-release-gate.mjs",
    "manifest:source": "node scripts/generate-source-manifest.mjs",
    "browser:qualification:audit": "node scripts/aggregate-browser-qualification.mjs",
    "release:audit:personal": "node scripts/audit-personal-release-evidence.mjs",
    "package:personal": "node scripts/package-personal-release.mjs",
    "package:personal:reproducible": "node scripts/reproducible-personal-package.mjs",
    "validate:package:external": "vitest run tests/integration/externalPackageValidation.test.ts",
    "test:e2e:smoke": "node scripts/run-e2e.mjs --browser chrome --test-file tests/e2e/privacy-network-package.spec.ts --grep @smoke",
    "validate:workflow-actions": "node scripts/validate-workflow-actions.mjs",
    "package:source": "node scripts/package-source.mjs",
    "validate:release-provenance": "node scripts/verify-release-provenance.mjs",
    "package:release:verified": "npm run build && node scripts/package-release.mjs && npm run manifest:source && npm run package:source && npm run validate:release-provenance",
    "release:gate:all": "node scripts/release-gate.mjs --browser all",
    "test:e2e:all": "node scripts/run-e2e.mjs --browser chrome && node scripts/run-e2e.mjs --browser edge",
    "validate:runtime:personal": "node scripts/validate-personal-runtime-packages.mjs"
  },
  "type": "module",
  "version": "1.6.19"
}
